# Copie para .env e ajuste se quiser. Os valores abaixo são só para uso local.
POSTGRES_USUARIO=pricehub
POSTGRES_SENHA=pricehub
RABBITMQ_USUARIO=pricehub
RABBITMQ_SENHA=pricehub
SEGREDO_DO_WEBHOOK_BIOFARMA=segredo-biofarma-dev
SEGREDO_DO_WEBHOOK_FARMAAZUL=segredo-farmaazul-dev
# Intervalos do ms-ingestao (segundos)
INTERVALO_DE_POLLING_S=5
NIVEL_DE_LOG=INFO
# Simulação programada das farmácias (100 preços por produto, um reajuste por vez)
SIMULACAO_ATIVA=true
INTERVALO_DA_SIMULACAO_S=5
INTERVALO_DA_SIMULACAO_DROGAPOPULAR_S=15
ATRASO_INICIAL_DA_SIMULACAO_S=20
# Endereço público usado nos links "Ver na farmácia"
URL_PUBLICA_DAS_LOJAS=http://localhost:8080/loja
# Porta do gateway no host
PORTA_DO_GATEWAY=8080
