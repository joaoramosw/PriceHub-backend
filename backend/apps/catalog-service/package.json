{
  "name": "catalog-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=@pricehub/source src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@pricehub/contracts": "workspace:*",
    "@pricehub/messaging": "workspace:*",
    "@pricehub/observability": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "prisma": "7.10.0",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@pricehub/testing": "workspace:*",
    "@types/amqplib": "^0.10.8",
    "amqplib": "0.10.9"
  }
}
