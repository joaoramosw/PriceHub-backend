{
  "name": "farmacia-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=@pricehub/source src/server.ts",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@pricehub/contracts": "workspace:*",
    "@pricehub/observability": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.5",
    "prisma": "7.10.0",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@pricehub/testing": "workspace:*"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "seed"
  ]
}
